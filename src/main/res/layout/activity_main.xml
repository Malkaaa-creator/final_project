<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧮 Тренажер счета"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Выбор уровня -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/level_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Уровень 1" />
        <Button
            android:id="@+id/level_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Уровень 2" />
        <Button
            android:id="@+id/level_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Уровень 3" />
    </LinearLayout>

    <!-- Статистика -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/score_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Счет: 0"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/lives_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Жизни: 3"
            android:textSize="18sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Вопрос -->
    <TextView
        android:id="@+id/question_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 + 3 = ?"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="20dp"/>

    <!-- Поле ввода ответа -->
    <EditText
        android:id="@+id/answer_input"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="Введи ответ"
        android:inputType="number"
        android:textSize="24sp"
        android:gravity="center"/>

    <!-- Кнопка проверки -->
    <Button
        android:id="@+id/check_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Проверить"
        android:textSize="18sp"
        android:layout_marginTop="20dp"/>

    <!-- Подсказка правильного ответа -->
    <TextView
        android:id="@+id/correct_answer_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:layout_marginTop="10dp"/>

    <!-- Новая игра -->
    <Button
        android:id="@+id/new_game_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔄 Новая игра"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="20dp"/>

</LinearLayout>